# Copy this file to .env and configure an API you already have.
# DeepSeek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=your-model-id
LLM_API_KEY=your-api-key

# OpenRouter alternative
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=provider/model-id

# Optional model IDs for project 08
# ROUTER_CHEAP_MODEL=provider/cheap-model
# ROUTER_STRONG_MODEL=provider/strong-model
# Fill current provider prices in USD per 1M tokens to enable budget filtering.
# ROUTER_CHEAP_INPUT_PER_1M=
# ROUTER_CHEAP_OUTPUT_PER_1M=
# ROUTER_STRONG_INPUT_PER_1M=
# ROUTER_STRONG_OUTPUT_PER_1M=

# PORT=5050
